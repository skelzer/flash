{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flash",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "routes": [
    // path route stays dormant until the apex DNS record is proxied (orange cloud)
    { "pattern": "luquematte.com/flash*", "zone_name": "luquematte.com" },
    // custom domain: Cloudflare creates the DNS record + certificate itself
    { "pattern": "flash.luquematte.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": {
    // OAuth client ID from Google Cloud Console; empty = Google sign-in hidden
    "GOOGLE_CLIENT_ID": "312332025518-hm2cf8d9jvm3o6nonom03bqgo07no4i9.apps.googleusercontent.com",
    // iOS OAuth client ID for the same Google project; ID tokens minted for the
    // native app carry this audience instead. Empty = accepted audiences are
    // just the web one above.
    "GOOGLE_IOS_CLIENT_ID": "",
    // the iOS bundle ID doubles as the audience of Apple's identity tokens
    "APPLE_BUNDLE_ID": "com.luquematte.flash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flash-db",
      "database_id": "4fbda6f9-15d0-4863-9526-e51eaf6ec15b"
    }
  ]
}
